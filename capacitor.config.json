{
  "appId": "br.com.govrp.app",
  "appName": "GOV.RP",
  "webDir": "dist",
  "backgroundColor": "#020713",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1800,
      "backgroundColor": "#020713",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#020713",
      "overlaysWebView": false
    }
  }
}
