VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Compatibilidade com configuracoes antigas do projeto.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Opcional: apenas para scripts e integracoes locais do lado do servidor.
# Nunca exponha essa chave no frontend.
# SUPABASE_SECRET_KEY=your-secret-server-key

# Exemplo opcional de introspecao/local admin:
# SUPABASE_PROJECT_REF=your-project-id

# Opcional: configure para habilitar as páginas de doação via Stripe.
# VITE_STRIPE_PUBLIC_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
