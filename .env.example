VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Chave pública do hCaptcha. Cadastre também a chave secreta no painel Auth do Supabase.
# VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Compatibilidade com configuracoes antigas do projeto.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Opcional: apenas para scripts e integracoes locais do lado do servidor.
# Nunca exponha essa chave no frontend.
# SUPABASE_SECRET_KEY=your-secret-server-key
# SUPABASE_URL=https://your-project-id.supabase.co

# Exemplo opcional de introspecao/local admin:
# SUPABASE_PROJECT_REF=your-project-id

# Opcional: configure para habilitar as páginas de doação por cartão.
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional: configure para habilitar doações por PIX.
# ABACATEPAY_API_KEY=abc_prod_...
